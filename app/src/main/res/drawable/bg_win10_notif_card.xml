<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#284FA7FA">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#FF262D3B" />
                    <stroke android:width="1.5dp" android:color="#FF4FA7FA" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#FF283040" />
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#FF242A36" />
                    <stroke android:width="1dp" android:color="#30FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#FF1C212A" />
                    <stroke android:width="1dp" android:color="#1AFFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
