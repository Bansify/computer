<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2EFFFFFF" />
                </shape>
            </item>
            <item android:gravity="bottom">
                <shape android:shape="rectangle">
                    <size android:height="2.5dp" />
                    <solid android:color="#FF4FA7FA" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3BFFFFFF" />
                </shape>
            </item>
            <item android:gravity="bottom">
                <shape android:shape="rectangle">
                    <size android:height="2.5dp" />
                    <solid android:color="#FF4FA7FA" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#16FFFFFF" />
                </shape>
            </item>
            <item android:gravity="bottom" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <size android:height="2dp" />
                    <solid android:color="#A84FA7FA" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
