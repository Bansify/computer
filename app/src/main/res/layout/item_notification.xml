<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_win10_notif_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Meta Row: App Icon + App Name + Relative Time + Dismiss X -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_notif_app_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="App Icon"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_notif_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B8C4D0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#80FFFFFF"
            android:textSize="10.5sp" />

        <ImageButton
            android:id="@+id/btn_dismiss_notif"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:contentDescription="Dismiss"
            android:padding="5dp" />
    </LinearLayout>

    <!-- Notification Title -->
    <TextView
        android:id="@+id/tv_notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F5FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Notification Body -->
    <TextView
        android:id="@+id/tv_notif_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="#B8C2CE"
        android:textSize="11.5sp" />

</LinearLayout>
