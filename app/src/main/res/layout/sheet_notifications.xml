<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notifications_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Subtle Scrim Backdrop behind right-side Action Center -->
    <View
        android:id="@+id/view_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:clickable="true"
        android:focusable="false" />

    <!-- Windows 10 Right-Side Action Center Panel (Docked right above taskbar) -->
    <LinearLayout
        android:id="@+id/panel_container"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bg_pc_notifications_panel"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="false"
        android:orientation="vertical">

        <!-- Action Center Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/img_sheet_bell"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/notifications_title" />

            <TextView
                android:id="@+id/tv_notif_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Action Center"
                android:textColor="#F5FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_clear_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Clear all"
                android:textColor="#4FA7FA"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_close_sheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:contentDescription="Close"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFFFFFF" />

        <!-- Permission Warning Banner (if access not granted) -->
        <LinearLayout
            android:id="@+id/card_permission_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_win10_notif_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_perm_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Warning" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Notification access required"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Enable notification access so alerts appear here in Action Center."
                android:textColor="#A6B0BC"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btn_enable_perm"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_win10_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Grant Access"
                android:textColor="#4FA7FA"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scrollable Notification Feed -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_notifications"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp" />

        <!-- Windows 10 Empty Notifications State -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_empty_bell"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="No new notifications" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="No new notifications"
                android:textColor="#B8C2CE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom Quick Actions Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#24FFFFFF" />

        <!-- Windows 10 Action Center Bottom Quick Action Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E6101319"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/tile_ac_wifi"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_win10_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|start"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_ac_wifi"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Wi-Fi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Network"
                    android:textColor="#E8EDF2"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_ac_bluetooth"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_win10_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|start"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_ac_bluetooth"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Bluetooth" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Bluetooth"
                    android:textColor="#E8EDF2"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_ac_settings"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_win10_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|start"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_ac_settings"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="All Settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="All settings"
                    android:textColor="#E8EDF2"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_ac_default_home"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/bg_win10_action_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|start"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_ac_default_home"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Default Launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Default PC"
                    android:textColor="#E8EDF2"
                    android:textSize="10.5sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
