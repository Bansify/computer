<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1E26"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- PC Device Header Banner matching Screenshot 14 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_win11_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_win_system"
                app:tint="#0078D4" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_system_pc_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bansify-PC"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_system_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Desktop Mode • Android 14"
                    android:textColor="#8E95A5"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Prominent Default Launcher Card -->
        <LinearLayout
            android:id="@+id/card_default_launcher_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_win11_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/img_default_launcher_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_win_system"
                app:tint="#4FA7FA" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_default_launcher_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default Home Launcher"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_default_launcher_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Set Bansify Computer as your default desktop launcher"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_set_default_launcher"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_primary_blue_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Set Default"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- System Cards Container -->
        <LinearLayout
            android:id="@+id/card_sys_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_focus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_nearby"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_multitasking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_activation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_troubleshoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_recovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_projecting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_remote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_clipboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_sys_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
