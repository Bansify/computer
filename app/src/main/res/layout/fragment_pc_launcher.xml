<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pc_launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Wallpaper Layer -->
    <ImageView
        android:id="@+id/img_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Desktop Scrim -->
    <View
        android:id="@+id/view_desktop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#20000000" />

    <!-- Desktop Icons Grid (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_desktop_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="44dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp" />

    <!-- Desktop Floating Windows Container (Above desktop icons, below taskbar) -->
    <FrameLayout
        android:id="@+id/container_floating_windows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="44dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- Start Menu Container (Flyout above taskbar) -->
    <com.bansify.computer.ui.view.FocusTrapFrameLayout
        android:id="@+id/container_start_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="50dp"
        android:visibility="gone">

        <include
            android:id="@+id/view_start_menu"
            layout="@layout/layout_pc_start_menu" />
    </com.bansify.computer.ui.view.FocusTrapFrameLayout>

    <!-- Quick Settings Flyout Container (Flyout above system tray) -->
    <com.bansify.computer.ui.view.FocusTrapFrameLayout
        android:id="@+id/container_quick_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="50dp"
        android:visibility="gone">

        <include
            android:id="@+id/view_quick_settings"
            layout="@layout/layout_pc_quick_settings" />
    </com.bansify.computer.ui.view.FocusTrapFrameLayout>

    <!-- Bottom Taskbar (Authentic Windows 10 Dark Acrylic Taskbar) -->
    <RelativeLayout
        android:id="@+id/layout_taskbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_pc_taskbar_solid"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <!-- Left Navigation Section (Start Logo + Windows 10 Search Box + Core Apps + Pinned Apps + Active Windows) -->
        <LinearLayout
            android:id="@+id/layout_taskbar_apps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/layout_taskbar_tray"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Far-Left Start Button (Our App Logo in Windows 10 Start Slot) -->
            <ImageButton
                android:id="@+id/btn_start"
                android:layout_width="46dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pc_start_btn"
                android:contentDescription="Start Menu"
                android:padding="7dp"
                android:scaleType="fitCenter" />

            <!-- Classic Windows 10 Taskbar Search Box -->
            <LinearLayout
                android:id="@+id/btn_search"
                android:layout_width="224dp"
                android:layout_height="match_parent"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_marginStart="1dp"
                android:background="@drawable/bg_pc_taskbar_search_bar"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/img_taskbar_search_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Type here to search"
                    android:textColor="@color/pc_taskbar_search_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Subtle Vertical Separator -->
            <View
                android:id="@+id/view_sep_apps"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:background="@color/pc_taskbar_separator" />

            <!-- Core Quick Apps (File Explorer & Browser in Windows 10 Taskbar Slots) -->
            <ImageButton
                android:id="@+id/btn_taskbar_files"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pc_start_btn"
                android:contentDescription="Files"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_taskbar_files" />

            <ImageButton
                android:id="@+id/btn_taskbar_browser"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_pc_start_btn"
                android:contentDescription="Browser"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_taskbar_browser" />

            <!-- Pinned Apps List on Taskbar -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_taskbar_pinned"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never" />

            <!-- Subtle Separator between Pinned and Active Apps -->
            <View
                android:id="@+id/view_sep_active"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/pc_taskbar_separator"
                android:visibility="gone" />

            <!-- Active Window Chips (Running/Minimized Floating Windows) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_taskbar_window_chips"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right Side: Authentic Windows 10 System Tray (Status Cluster -> Clock/Date -> Action Center -> Quick Control -> Show Desktop Sliver) -->
        <LinearLayout
            android:id="@+id/layout_taskbar_tray"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Clickable Tray Cluster (Opens Quick Settings) -->
            <LinearLayout
                android:id="@+id/layout_tray_cluster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/img_tray_network"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="3dp"
                    android:contentDescription="Network" />

                <ImageView
                    android:id="@+id/img_tray_volume"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="3dp"
                    android:contentDescription="Volume" />

                <ImageView
                    android:id="@+id/img_tray_battery"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="3dp"
                    android:contentDescription="Battery" />

                <TextView
                    android:id="@+id/tv_tray_battery_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textColor="@color/pc_taskbar_text_secondary"
                    android:textSize="10sp"
                    tools:text="100%" />
            </LinearLayout>

            <!-- Clock and Date Cluster (Windows 10 Centered 2-Line Stack) -->
            <LinearLayout
                android:id="@+id/layout_clock_cluster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tv_taskbar_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pc_taskbar_text"
                    android:textSize="11sp"
                    android:textStyle="normal"
                    tools:text="12:00 PM" />

                <TextView
                    android:id="@+id/tv_taskbar_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/pc_taskbar_text_secondary"
                    android:textSize="9.5sp"
                    tools:text="09/15/2026" />
            </LinearLayout>

            <!-- Windows 10 Action Center Notifications Button (Right of Clock) -->
            <FrameLayout
                android:id="@+id/btn_notifications_container"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageButton
                    android:id="@+id/btn_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:contentDescription="@string/notifications_title"
                    android:padding="11dp" />

                <TextView
                    android:id="@+id/tv_notif_badge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_circle_badge"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Right Corner Quick Control Toggle -->
            <FrameLayout
                android:id="@+id/btn_taskbar_corner_launcher"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pc_start_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Launcher Quick Control">

                <ImageView
                    android:id="@+id/img_corner_launcher_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Windows 10 Show Desktop Separator & Far-Right Edge Sliver -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/pc_taskbar_separator" />

            <View
                android:id="@+id/btn_show_desktop"
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:contentDescription="Show Desktop"
                android:focusable="true" />
        </LinearLayout>

    </RelativeLayout>

    <!-- Corner Floating Trigger Button (Visible when Taskbar is Hidden) -->
    <FrameLayout
        android:id="@+id/btn_floating_corner_tab"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_pc_start_btn"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Reveal Taskbar"
        android:visibility="gone">

        <ImageView
            android:id="@+id/img_floating_corner_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>

</FrameLayout>
