<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_taskbar_pinned"
    android:layout_width="42dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pc_pinned_app"
    android:clickable="true"
    android:focusable="true">

    <!-- Crisp Windows 10 Taskbar App Icon -->
    <ImageView
        android:id="@+id/img_taskbar_pinned_icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tv_taskbar_pinned_fallback"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="@color/pc_taskbar_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Windows 10 Bottom Accent Indicator Line -->
    <View
        android:id="@+id/view_pinned_indicator"
        android:layout_width="16dp"
        android:layout_height="2dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_taskbar_active_indicator"
        android:alpha="0.55"
        android:visibility="visible" />

</FrameLayout>
