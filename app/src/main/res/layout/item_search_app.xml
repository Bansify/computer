<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginVertical="1dp"
    android:background="@drawable/bg_win10_search_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <ImageView
        android:id="@+id/img_app_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="App Icon"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F5FFFFFF"
            android:textSize="13sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tv_app_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8FA0B2"
            android:textSize="10.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/img_launch_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="Open" />

</LinearLayout>
