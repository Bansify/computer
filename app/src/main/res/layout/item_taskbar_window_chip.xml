<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="1dp"
    android:background="@drawable/bg_taskbar_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <ImageView
        android:id="@+id/img_chip_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        tools:src="@drawable/ic_folder" />

    <TextView
        android:id="@+id/tv_chip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:ellipsize="end"
        android:maxWidth="118dp"
        android:maxLines="1"
        android:textColor="#F2FFFFFF"
        android:textSize="11.5sp"
        tools:text="Files" />

    <!-- Subtle Windows 10 Hover/Tap Close Button -->
    <TextView
        android:id="@+id/btn_chip_close"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:text="×"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:textStyle="normal" />

</LinearLayout>
